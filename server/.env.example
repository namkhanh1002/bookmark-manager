# PostgreSQL connection string (Neon / local).
# Neon example: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookmark_manager?schema=public"

# Server
PORT=4000
NODE_ENV=development

# CORS origin of the Vite dev server (comma separated for multiple origins)
CLIENT_ORIGIN="http://localhost:5173"

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Access token lifetime (ex: 7d, 12h, 3600)
JWT_EXPIRES_IN="7d"
